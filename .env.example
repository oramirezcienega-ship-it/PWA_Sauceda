# Variables de entorno para conectar Supabase.
# Copia este archivo como ".env.local" y rellena los valores reales.
# (En Netlify estas mismas variables se configuran en Site settings → Environment variables.)

# URL de tu proyecto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# SERVICE ROLE KEY (Project Settings → API → service_role).
# ¡SECRETA! Solo se usa en el servidor; NUNCA la pongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Auth del admin (Supabase Auth) ---
# Estas SÍ llevan NEXT_PUBLIC_ porque el login corre en el navegador.
# La anon key es pública/segura de exponer (Project Settings → API → anon public).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Notificaciones por correo (Resend) ---
# API key de Resend (resend.com → API Keys). Si no se pone, no se envían correos.
RESEND_API_KEY=tu-resend-api-key
# Remitente verificado en Resend, ej: SAUCEDA <notificaciones@saucedamx.com>
RESEND_FROM=SAUCEDA <notificaciones@saucedamx.com>
# URL pública del sitio (para los enlaces del portal en los correos).
SITE_URL=https://app.saucedamx.com

# --- Captación por WhatsApp (Meta Cloud API) ---
# Token que TÚ inventas; debe coincidir con el que pongas en el webhook de Meta.
WHATSAPP_VERIFY_TOKEN=inventa-una-frase-secreta
# App Secret de tu app de Meta (Settings → Basic). Valida la firma de los webhooks.
WHATSAPP_APP_SECRET=tu-meta-app-secret

# --- Envío saliente por WhatsApp (Meta Cloud API) ---
# Token de acceso de la app de WhatsApp (permanente o de sistema).
WHATSAPP_TOKEN=tu-whatsapp-access-token
# ID del número emisor (WhatsApp Manager → API Setup → Phone number ID).
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
# ID de la cuenta de WhatsApp Business (WABA). Necesario para sincronizar las
# plantillas aprobadas en el panel (Business Settings → Cuentas → WhatsApp).
WHATSAPP_WABA_ID=tu-waba-id
# (Opcional) Plantilla de bienvenida aprobada para el primer contacto en frío.
WHATSAPP_BIENVENIDA_TEMPLATE=
WHATSAPP_BIENVENIDA_IDIOMA=es_MX

# Plantilla para notificaciones de nuevo lead a los asesores
WHATSAPP_TEMPLATE_AGENTE_NOTIF=notificacion_nuevo_lead
WHATSAPP_TEMPLATE_AGENTE_LANG=es

# --- Agente de IA (Claude / Anthropic) para responder WhatsApp ---
# API key de Anthropic (console.anthropic.com → API Keys). Si no se pone, la
# IA no responde (todo sigue funcionando manualmente).
ANTHROPIC_API_KEY=tu-anthropic-api-key
# (Opcional) Modelo. Por defecto claude-sonnet-4-6. Para menor costo:
# claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6
# (Opcional) Interruptor. Pon "off" para desactivar la IA sin quitar la key.
IA_AGENTE=on
# (Opcional) Instrucciones/conocimiento extra para el agente (FAQ, tono, etc.).
IA_INSTRUCCIONES=

# --- Conmutador e IVR (Twilio & Vapi.ai) ---
# URI de SIP de Vapi para desviar llamadas cuando no hay agente disponible.
# Ej: sip:sauceda-bot@sip.vapi.ai
VAPI_SIP_URI=sip:sauceda-bot@sip.vapi.ai
